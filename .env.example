# ==============================================================================
# Gemini Enterprise + Agent Registry + Agent Gateway + Cloud/Model Armor + SDP
# Hands-On Demo & Qwiklabs Lab Configuration (.env)
#
# Copy this file to .env and set your Google Cloud Project values:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Project Identifiers
PROJECT_ID=your-gcp-project-id
# Optional: Automatically resolved via Cloud Resource Manager API if left blank
PROJECT_NUMBER=
# Optional: Organization ID (resolved automatically if project belongs to an Org)
ORG_ID=

# 2. Location & Region Settings
# Gemini Enterprise App Location (global | us)
GE_LOCATION=global
# Agent Platform (Agent Registry, Agent Gateway, ACT, PSC-I) Region
# IMPORTANT: Must be us-central1 when binding to a global or us Gemini Enterprise App
REGION=us-central1
# Model Armor Template Locations:
# - GE Assistant requires multi-region 'us' (for global/us GE Apps)
# - Agent Gateway Inline CONTENT_AUTHZ requires single region 'us-central1'
MA_GE_LOCATION=us
MA_AGW_LOCATION=us-central1
BQ_LOCATION=US

# 3. Target AWS MCP Server Connectivity Mode
# - simulated_aws_vpc : Deploys the built-in Simulated AWS FastMCP Server (Inventory & OMS)
#                       on Cloud Run behind an External ALB + Google Cloud Armor WAF
# - external_aws_url  : Connects to an existing external AWS Custom MCP Server URL
MCP_TARGET_MODE=simulated_aws_vpc
MOCK_MCP_SERVICE_NAME=aws-sim-fastmcp-server
# Used when MCP_TARGET_MODE=external_aws_url (or auto-populated after Task 1 deployment)
INVENTORY_MCP_URL=
OMS_MCP_URL=
MCP_AUTH_TOKEN=mcp_demo_secret_token_2026

# 4. Network, PSC Network Attachment, Cloud NAT & Cloud DNS (us-central1)
VPC_NAME=default
PSCI_SUBNET_NAME=ge-agw-psci-subnet-usc1
PSCI_SUBNET_CIDR=10.250.10.0/26
CLOUD_ROUTER_NAME=ge-agw-nat-router-usc1
CLOUD_NAT_NAME=ge-agw-cloud-nat-usc1
CLOUD_NAT_STATIC_IP_NAME=ge-agw-nat-static-ip-usc1
PSC_ATTACHMENT_NAME=ge-agw-network-attachment-usc1
DNS_PRIVATE_ZONE_NAME=aws-mcp-private-zone
DNS_PRIVATE_DOMAIN=mcp.aws.cymbal.internal.

# 5. Agent Registry, Agent Connectivity Template (ACT) & Egress Agent Gateway IDs
INVENTORY_MCP_REGISTRY_ID=cymbal-store-inventory-mcp
OMS_MCP_REGISTRY_ID=cymbal-oms-order-mcp
GOOGLEAPIS_REGISTRY_ID=googleapis
ACT_ID=cymbal-ge-aws-mcp-act-usc1
AGENT_GATEWAY_ID=cymbal-ge-egress-agw-usc1

# 6. Cloud Armor, Model Armor, SDP Content Policy & IAP Authz Resource IDs
CLOUD_ARMOR_POLICY_NAME=mcp-edge-cloud-armor-waf
MA_GE_TEMPLATE_ID=cymbal-ge-assistant-armor-tmpl
MA_AGW_TEMPLATE_ID=cymbal-agw-inline-armor-tmpl
SDP_POLICY_ID=cymbal-ge-sdp-content-policy
IAP_AUTHZ_EXT_ID=cymbal-agw-iap-authz-ext
MA_AUTHZ_EXT_ID=cymbal-agw-ma-content-authz-ext
IAP_AUTHZ_POLICY_ID=cymbal-agw-request-authz-policy
MA_AUTHZ_POLICY_ID=cymbal-agw-content-authz-policy
UAP_ACCESS_POLICY_ID=cymbal-agent-egress-access-policy
UAP_POLICY_BINDING_ID=cymbal-agent-egress-binding

# 7. Security Policy Enforcement Modes
# Model Armor Enforcement Mode: INSPECT_ONLY | INSPECT_AND_BLOCK
MODEL_ARMOR_ENFORCEMENT=INSPECT_AND_BLOCK
# SDP Content Policy Verdict on PII Match: ALLOW (Inspect-only + BQ Log) | BLOCK
SDP_VERDICT=BLOCK
# IAP Authorization Mode: V1_IAM (Zero Org Policy required) | V2_UAP (Unified Access Policy)
IAP_AUTHZ_MODE=V1_IAM

# 8. Gemini Enterprise App & BigQuery Audit Destination
GE_ENGINE_ID=cymbal-enterprise-ge-app
BQ_DATASET_ID=security_audit_logs
BQ_TABLE_ID=sdp_content_policy_action_logs
