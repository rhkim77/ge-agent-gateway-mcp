        <mxCell id="edge-16" value="Or Private RFC 1918 Route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E69138;strokeWidth=1.8;dashed=1;dashPattern=4 4;fontSize=10;fontColor=#E69138;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gcp-psci" target="gcp-vpn">
