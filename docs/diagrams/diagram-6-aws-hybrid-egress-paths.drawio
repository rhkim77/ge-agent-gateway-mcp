        <mxCell id="edge-15" value="Public Route (0.0.0.0/0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38761D;strokeWidth=1.8;fontSize=10;fontColor=#38761D;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gcp-psci" target="gcp-nat">
          <mxGeometry relative="1" as="geometry" />
