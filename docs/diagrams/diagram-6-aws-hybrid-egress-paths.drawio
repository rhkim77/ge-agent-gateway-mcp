<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="6. AWS Hybrid Egress Paths" id="diagram-6-aws-hybrid-egress-paths">
    <mxGraphModel dx="1400" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-banner" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Figure 6. Production AWS MCP Connectivity: Path A (Public Cloud NAT /32) vs. Path B (Private VPN / Interconnect /26)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size:11px;&quot;&gt;Google Cloud &lt;-&gt; AWS Hybrid Network Topology &amp; AWS Security Group Inbound Allowlist Configuration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafd;strokeColor=#1a73e8;strokeWidth=1.5;align=left;spacingLeft=16;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="zone-11" value="1. Google Cloud Customer VPC (us-central1) — EGRESS AGENT GATEWAY · PSC-I SUBNET (10.250.10.0/26)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#E2EFFD;strokeColor=#1967D2;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#1967D2;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="105" width="560" height="590" as="geometry" />
        </mxCell>
        <mxCell id="zone-12" value="2A. Path A: Public Internet over HTTPS (TLS 1.3) — AWS SECURITY GROUP ALLOWS SINGLE CLOUD NAT STATIC IP (/32)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#D9EAD3;strokeColor=#38761D;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#38761D;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="685" y="105" width="670" height="280" as="geometry" />
        </mxCell>
        <mxCell id="zone-13" value="2B. Path B: Private HA VPN / Dedicated Interconnect — AWS SECURITY GROUP ALLOWS GCP PSC-I SUBNET CIDR (10.250.10.0/26)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#FFF2CC;strokeColor=#E69138;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#E69138;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="685" y="415" width="670" height="280" as="geometry" />
        </mxCell>
        <mxCell id="gcp-agw" value="&lt;b&gt;Egress Agent Gateway + ACT (ALL_TRAFFIC)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Routes all outbound MCP calls into Customer VPC via PSC-I)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="75" y="175" width="500" height="74" as="geometry" />
        </mxCell>
        <mxCell id="gcp-agw-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="gcp-agw">
          <mxGeometry x="10" y="19" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="gcp-psci" value="&lt;b&gt;PSC Network Attachment &amp; Subnet (10.250.10.0/26)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(ge-agw-psci-subnet-usc1 · IPv4-Only · Remove DNS AAAA Records)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="75" y="290" width="500" height="74" as="geometry" />
        </mxCell>
        <mxCell id="gcp-psci-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="gcp-psci">
          <mxGeometry x="10" y="19" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="gcp-nat" value="&lt;b&gt;Path A Egress: Cloud NAT Gateway (Manual Static IP)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(SNATs outbound traffic to single &lt;CLOUD_NAT_STATIC_IP&gt;/32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="75" y="410" width="500" height="74" as="geometry" />
        </mxCell>
        <mxCell id="gcp-nat-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="gcp-nat">
          <mxGeometry x="10" y="19" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="gcp-vpn" value="&lt;b&gt;Path B Egress: Cloud Router + HA VPN / Interconnect&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Advertises Custom BGP Route 10.250.10.0/26 to AWS TGW/VGW)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="75" y="530" width="500" height="74" as="geometry" />
        </mxCell>
        <mxCell id="gcp-vpn-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="gcp-vpn">
          <mxGeometry x="10" y="19" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="aws-alb-pub" value="&lt;b&gt;Internet-Facing AWS ALB + AWS WAF&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Inbound SG Rule: Allow TCP 443 from &lt;CLOUD_NAT_IP&gt;/32 · Allow python-httpx)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="720" y="172" width="600" height="72" as="geometry" />
        </mxCell>
        <mxCell id="aws-alb-pub-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="aws-alb-pub">
          <mxGeometry x="10" y="18" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="aws-ecs-pub" value="&lt;b&gt;AWS ECS Fargate / EKS FastMCP Containers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Serves Full TLS Certificate Chain: Leaf + Intermediate CA Bundle)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="720" y="282" width="600" height="72" as="geometry" />
        </mxCell>
        <mxCell id="aws-ecs-pub-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="aws-ecs-pub">
          <mxGeometry x="10" y="18" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="aws-alb-priv" value="&lt;b&gt;Internal Private AWS ALB (RFC 1918)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Inbound SG Rule: Allow TCP 443 from 10.250.10.0/26 over HA VPN / DX)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="720" y="482" width="600" height="72" as="geometry" />
        </mxCell>
        <mxCell id="aws-alb-priv-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="aws-alb-priv">
          <mxGeometry x="10" y="18" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="aws-ecs-priv" value="&lt;b&gt;AWS Private FastMCP Server (/inventory/mcp &amp; /oms/mcp)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Streamable HTTP JSON-RPC 2.0 · Idle Timeout &gt;= 120s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="720" y="592" width="600" height="72" as="geometry" />
        </mxCell>
        <mxCell id="aws-ecs-priv-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="aws-ecs-priv">
          <mxGeometry x="10" y="18" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-14" value="PSC-I Egress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1967D2;strokeWidth=1.8;fontSize=10;fontColor=#1967D2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gcp-agw" target="gcp-psci">
          <mxGeometry relative="1" as="geometry" />
