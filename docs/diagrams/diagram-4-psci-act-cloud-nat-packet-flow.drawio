<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="4. PSC-I &amp; Cloud NAT Flow" id="diagram-4-psci-act-cloud-nat-packet-flow">
    <mxGraphModel dx="1400" dy="730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="730" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-banner" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Figure 4. Deterministic Egress Packet Flow via PSC Network Attachment, ACT (ALL_TRAFFIC) &amp; Cloud NAT (/32)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size:11px;&quot;&gt;Google Cloud — Step-by-Step Packet Routing from Google Managed Tenant VPC into Customer VPC and Out to AWS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafd;strokeColor=#1a73e8;strokeWidth=1.5;align=left;spacingLeft=16;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="zone-11" value="Phase 1. Google Managed Tenant Runtime — GEMINI ENTERPRISE &amp; EGRESS AGENT GATEWAY" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#E2EFFD;strokeColor=#1967D2;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#1967D2;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="105" width="405" height="580" as="geometry" />
        </mxCell>
        <mxCell id="zone-12" value="Phase 2. Customer VPC Egress Hub (us-central1) — PSC NETWORK ATTACHMENT · /26 SUBNET · CLOUD NAT" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#D9EAD3;strokeColor=#38761D;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#38761D;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="495" y="105" width="410" height="580" as="geometry" />
        </mxCell>
        <mxCell id="zone-13" value="Phase 3. AWS Target MCP Environment — CLOUD ARMOR / AWS SECURITY GROUP &amp; FASTMCP" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#FFF2CC;strokeColor=#E69138;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#E69138;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="105" width="405" height="580" as="geometry" />
        </mxCell>
        <mxCell id="p1-1" value="&lt;b&gt;1. Gemini Enterprise Tool Invocation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(User asks for Store Inventory or Order Notes)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="78" y="185" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p1-1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p1-1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-2" value="&lt;b&gt;2. Egress Agent Gateway (Envoy Proxy)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Checks IAP roles/iap.egressor &amp; Registry Host)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="78" y="320" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p1-2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p1-2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-3" value="&lt;b&gt;3. ACT (vpcEgress: ALL_TRAFFIC)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Steers all outbound MCP packets to PSC-I NIC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="78" y="455" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p1-3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p1-3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-1" value="&lt;b&gt;4. PSC Network Attachment Entry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Bridges Google Tenant NIC into Customer VPC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="530" y="185" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2-1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p2-1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-2" value="&lt;b&gt;5. Customer PSC-I Subnet (10.250.10.0/26)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Packet receives Customer VPC Private IPv4)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="530" y="320" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2-2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p2-2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-3" value="&lt;b&gt;6. Cloud Router &amp; Cloud NAT (Manual IP)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(SNATs Source IP to single Static IP /32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="530" y="455" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2-3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p2-3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3-1" value="&lt;b&gt;7. Cloud Armor / AWS Security Group&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Verifies Source IP == Static /32 NAT IP &amp; WAF)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="982" y="185" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3-1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p3-1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3-2" value="&lt;b&gt;8. FastMCP JSON-RPC 2.0 Execution&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(POST /inventory/mcp or /oms/mcp over TLS 1.3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="982" y="320" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3-2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p3-2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3-3" value="&lt;b&gt;9. Inline Model Armor &amp; SDP Inspection&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Scans MCP response before returning to GE LLM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="982" y="455" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3-3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p3-3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-14" value="Invoke Managed URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1967D2;strokeWidth=1.8;fontSize=10;fontColor=#1967D2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-1" target="p1-2">
