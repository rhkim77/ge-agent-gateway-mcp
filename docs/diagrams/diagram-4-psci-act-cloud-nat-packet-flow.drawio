        <mxCell id="edge-19" value="Static /32 NAT IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E69138;strokeWidth=1.8;fontSize=10;fontColor=#E69138;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-3" target="p3-1">
          <mxGeometry relative="1" as="geometry" />
