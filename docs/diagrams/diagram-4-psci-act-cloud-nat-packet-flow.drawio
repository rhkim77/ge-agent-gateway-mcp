        <mxCell id="edge-20" value="HTTP 200 Allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E69138;strokeWidth=1.8;fontSize=10;fontColor=#E69138;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-1" target="p3-2">
