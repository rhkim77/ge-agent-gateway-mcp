        <mxCell id="p1-3" value="&lt;b&gt;3. ACT (vpcEgress: ALL_TRAFFIC)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Steers all outbound MCP packets to PSC-I NIC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
