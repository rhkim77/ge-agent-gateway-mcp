  <diagram name="4. PSC-I &amp; Cloud NAT Flow" id="diagram-4-psci-act-cloud-nat-packet-flow">
    <mxGraphModel dx="1400" dy="730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="730" math="0" shadow="0">
      <root>
