  <diagram name="5. Dual Model Armor &amp; SDP" id="diagram-5-dual-model-armor-sdp-inspection">
    <mxGraphModel dx="1400" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-banner" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Figure 5. Dual-Location Model Armor (locations/us &amp; locations/us-central1) &amp; SDP Inline Inspection Architecture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size:11px;&quot;&gt;Google Cloud — Why Two Separate Model Armor Templates Are Required to Defend Both User Prompts and External MCP Outputs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafd;strokeColor=#1a73e8;strokeWidth=1.5;align=left;spacingLeft=16;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="zone-11" value="Plane 1. Assistant Prompt &amp; Response Protection (Location: us) — MULTI-REGION &#x27;locations/us&#x27; — DIRECT JAILBREAK &amp; PII GUARDRAIL" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#E2EFFD;strokeColor=#1967D2;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#1967D2;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="105" width="620" height="575" as="geometry" />
        </mxCell>
        <mxCell id="zone-12" value="Plane 2. Agent Gateway Inline Tool Output Protection (us-central1) — REGIONAL &#x27;locations/us-central1&#x27; — INDIRECT PROMPT INJECTION BLOCK" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#FCE5CD;strokeColor=#B45F06;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#B45F06;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="735" y="105" width="620" height="575" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="&lt;b&gt;1. Enterprise User Prompt / File Upload&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(User submits prompt or queries VIP Customer Claim CLM-PII-9001)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="85" y="185" width="540" height="78" as="geometry" />
        </mxCell>
        <mxCell id="u1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="u1">
          <mxGeometry x="10" y="21" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="&lt;b&gt;2. Gemini Enterprise App (global / us)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Invokes bound Model Armor Template &amp; SDP Content Policy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="85" y="298" width="540" height="78" as="geometry" />
        </mxCell>
        <mxCell id="u2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="u2">
          <mxGeometry x="10" y="21" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="&lt;b&gt;3. Model Armor Template (locations/us)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(cymbal-ge-assistant-ma-us · Blocks Direct Jailbreak &amp; Malicious URLs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="85" y="411" width="540" height="78" as="geometry" />
        </mxCell>
        <mxCell id="u3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="u3">
          <mxGeometry x="10" y="21" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="&lt;b&gt;4. SDP Inspect &amp; De-identify Templates (locations/us)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(KOREA_RRN &amp; Luhn CREDIT_CARD_NUMBER -&gt; Masks &#x27;******&#x27; or BLOCK)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="85" y="524" width="540" height="78" as="geometry" />
        </mxCell>
        <mxCell id="u4-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="u4">
          <mxGeometry x="10" y="21" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;1. External AWS OMS MCP Server Response&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Returns Order ORD-INJ-9999 with hidden &#x27;[SYSTEM OVERRIDE...]&#x27; note)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
