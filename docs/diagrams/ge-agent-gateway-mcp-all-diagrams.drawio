  <diagram name="2. Challenges vs Solutions" id="diagram-2-problems-vs-5layer-solutions">
    <mxGraphModel dx="1400" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-banner" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Figure 2. Direct Multi-Cloud MCP Challenges vs. 5-Layer Governance Architecture Solutions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size:11px;&quot;&gt;Google Cloud — Why Direct MCP URLs Fail Enterprise Security Review and How Each Governance Layer Resolves It&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafd;strokeColor=#1a73e8;strokeWidth=1.5;align=left;spacingLeft=16;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="zone-11" value="A. Unmanaged Direct MCP Challenges (4 Security &amp; Network Gaps) — RISKS WITHOUT AGENT GATEWAY &amp; REGISTRY" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#FCE8E6;strokeColor=#D93025;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#D93025;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="105" width="595" height="575" as="geometry" />
        </mxCell>
        <mxCell id="zone-12" value="B. 5-Layer Google Cloud Governance Solutions (Verified Architecture) — DETERMINISTIC EGRESS · ZERO-TRUST AUTHZ · INLINE DLP" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#E2EFFD;strokeColor=#1967D2;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#1967D2;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="105" width="595" height="575" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Challenge 1. Non-Deterministic Outbound IP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Cloud Conduit uses dynamic CIDR pools -&gt; AWS SG cannot allowlist a single IP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="185" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Challenge 2. Shadow MCP &amp; Uncontrolled Destructive Tools&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;No central catalog or tool-level block -&gt; Risk of cancel_all_store_orders call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Challenge 3. Indirect Prompt Injection via Poisoned MCP Output&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Malicious instructions inside supplier order notes hijack the LLM context window&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="425" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Challenge 4. Unmasked Customer PII Exposure &amp; Missing Audit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;VIP claim responses expose KOREA_RRN &amp; Credit Cards without masking or audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="545" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p4-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p4">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Solution 1. PSC Network Attachment + ACT + Cloud NAT (/32)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Routes Google Tenant traffic into Customer VPC (/26) to exit via Static /32 IP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="185" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Solution 2. Agent Registry (us-central1) + IAP Request Authz&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Catalogs MCP UUIDs + ToolSpecs &amp; enforces roles/iap.egressor + CEL tool block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="305" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Solution 3. Dual-Location Model Armor (us &amp; us-central1)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Scans user prompts in &#x27;us&#x27; and inspects AWS MCP outputs inline (&#x27;us-central1&#x27;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="425" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Solution 4. SDP Content Policy (Luhn Check) + BigQuery Audit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Masks KOREA_RRN / Credit Cards and streams correlated assistToken audit logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="545" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s4-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s4">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-13" value="Solved by Layer 1 &amp; 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1967D2;strokeWidth=1.8;fontSize=10;fontColor=#1967D2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-14" value="Solved by Layer 2 &amp; 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38761D;strokeWidth=1.8;fontSize=10;fontColor=#38761D;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-15" value="Solved by Layer 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B45F06;strokeWidth=1.8;fontSize=10;fontColor=#B45F06;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-16" value="Solved by Layer 5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1967D2;strokeWidth=1.8;fontSize=10;fontColor=#1967D2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. 7-Step Immutable Workflow" id="diagram-3-immutable-provisioning-sequence">
    <mxGraphModel dx="1440" dy="730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="730" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-banner" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Figure 3. 7-Step Immutable Provisioning Workflow &amp; Region Pinning (us-central1 vs. us / global)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size:11px;&quot;&gt;Google Cloud — Mandatory Bottom-Up Provisioning Order Required by AgentConnectivityTemplate (ACT) Immutability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafd;strokeColor=#1a73e8;strokeWidth=1.5;align=left;spacingLeft=16;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1390" height="52" as="geometry" />
        </mxCell>
        <mxCell id="zone-11" value="Phase 1. Edge Target &amp; VPC Network Foundation — CLOUD RUN · CLOUD ARMOR · PSC-I SUBNET (/26)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#E2EFFD;strokeColor=#1967D2;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#1967D2;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="105" width="420" height="580" as="geometry" />
        </mxCell>
        <mxCell id="zone-12" value="Phase 2. Catalog &amp; 1-Step Immutable Gateway — AGENT REGISTRY · ACT · EGRESS GATEWAY (us-central1)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#D9EAD3;strokeColor=#38761D;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#38761D;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="105" width="420" height="580" as="geometry" />
        </mxCell>
        <mxCell id="zone-13" value="Phase 3. Zero-Trust Authz, AI Guardrails &amp; GE — IAP · MODEL ARMOR (us &amp; usc1) · SDP · BIGQUERY" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#FCE5CD;strokeColor=#B45F06;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#B45F06;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="975" y="105" width="420" height="580" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Step 1. Deploy Simulated AWS FastMCP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Cloud Run us-central1 · /inventory/mcp &amp; /oms/mcp)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="75" y="185" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Step 2. Create Cloud Armor Edge WAF&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Global Policy · SQLi/XSS/Scanner &amp; /32 Allowlist)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="75" y="315" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Step 3. Provision VPC PSC-I &amp; Cloud NAT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(us-central1 · 10.250.10.0/26 · Static IP /32 · Attachment)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="75" y="445" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Step 4. Register MCPs in Agent Registry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Location: us-central1 ONLY · Assigns MCP UUIDs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s4-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s4">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Step 5. Create ACT (ALL_TRAFFIC)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(us-central1 · Binds PSC Network Attachment)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="540" y="315" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s5-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s5">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;Step 6. 1-Step Create Egress Agent Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(us-central1 · Immutable Binding to ACT &amp; Registry)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="540" y="445" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s6-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s6">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;Step 7. Bind IAP Request Authz (V1 / UAP V2)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Grant roles/iap.egressor · Block destructiveHint=true)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="1005" y="185" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s7-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s7">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;Step 8. Create Dual Model Armor &amp; SDP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Model Armor in &#x27;us&#x27; &amp; &#x27;us-central1&#x27; + SDP Luhn Mask)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0E0E0;strokeWidth=1;arcSize=8;fontColor=#202124;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="1005" y="315" width="360" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s8-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s8">
