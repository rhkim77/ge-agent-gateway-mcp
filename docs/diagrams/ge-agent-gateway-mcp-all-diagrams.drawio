        <mxCell id="p1-2" value="&lt;b&gt;2. Egress Agent Gateway (Envoy Proxy)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;(Checks IAP roles/iap.egressor &amp; Registry Host)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
