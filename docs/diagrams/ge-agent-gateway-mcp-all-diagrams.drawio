        <mxCell id="zone-11" value="Phase 1. Google Managed Tenant Runtime — GEMINI ENTERPRISE &amp; EGRESS AGENT GATEWAY" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#E2EFFD;strokeColor=#1967D2;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#1967D2;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="105" width="405" height="580" as="geometry" />
