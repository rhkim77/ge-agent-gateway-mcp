<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="2. Challenges vs Solutions" id="diagram-2-problems-vs-5layer-solutions">
    <mxGraphModel dx="1400" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-banner" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Figure 2. Direct Multi-Cloud MCP Challenges vs. 5-Layer Governance Architecture Solutions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size:11px;&quot;&gt;Google Cloud — Why Direct MCP URLs Fail Enterprise Security Review and How Each Governance Layer Resolves It&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafd;strokeColor=#1a73e8;strokeWidth=1.5;align=left;spacingLeft=16;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="zone-11" value="A. Unmanaged Direct MCP Challenges (4 Security &amp; Network Gaps) — RISKS WITHOUT AGENT GATEWAY &amp; REGISTRY" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#FCE8E6;strokeColor=#D93025;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#D93025;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="105" width="595" height="575" as="geometry" />
        </mxCell>
        <mxCell id="zone-12" value="B. 5-Layer Google Cloud Governance Solutions (Verified Architecture) — DETERMINISTIC EGRESS · ZERO-TRUST AUTHZ · INLINE DLP" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#E2EFFD;strokeColor=#1967D2;strokeWidth=1.5;dashed=1;rounded=1;arcSize=4;fontColor=#1967D2;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="105" width="595" height="575" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Challenge 1. Non-Deterministic Outbound IP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Cloud Conduit uses dynamic CIDR pools -&gt; AWS SG cannot allowlist a single IP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="185" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Challenge 2. Shadow MCP &amp; Uncontrolled Destructive Tools&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;No central catalog or tool-level block -&gt; Risk of cancel_all_store_orders call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Challenge 3. Indirect Prompt Injection via Poisoned MCP Output&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Malicious instructions inside supplier order notes hijack the LLM context window&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="425" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Challenge 4. Unmasked Customer PII Exposure &amp; Missing Audit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;VIP claim responses expose KOREA_RRN &amp; Credit Cards without masking or audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=2;arcSize=8;fontColor=#D93025;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="70" y="545" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p4-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="p4">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Solution 1. PSC Network Attachment + ACT + Cloud NAT (/32)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Routes Google Tenant traffic into Customer VPC (/26) to exit via Static /32 IP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="185" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s1-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s1">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Solution 2. Agent Registry (us-central1) + IAP Request Authz&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Catalogs MCP UUIDs + ToolSpecs &amp; enforces roles/iap.egressor + CEL tool block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="305" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s2-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s2">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Solution 3. Dual-Location Model Armor (us &amp; us-central1)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Scans user prompts in &#x27;us&#x27; and inspects AWS MCP outputs inline (&#x27;us-central1&#x27;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="425" width="545" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s3-icon" value="" style="shape=image;html=1;verticalAlign=middle;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;part=1;connectable=0;" vertex="1" parent="s3">
          <mxGeometry x="10" y="23" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Solution 4. SDP Content Policy (Luhn Check) + BigQuery Audit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot; style=&quot;font-size: 10px;&quot;&gt;Masks KOREA_RRN / Credit Cards and streams correlated assistToken audit logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#1967D2;strokeWidth=2;arcSize=8;fontColor=#1967D2;align=left;spacingLeft=54;" vertex="1" parent="1">
          <mxGeometry x="785" y="545" width="545" height="82" as="geometry" />
        </mxCell>
